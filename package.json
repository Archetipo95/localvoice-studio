{
  "name": "localvoice-studio",
  "version": "1.1.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev --port 3000",
    "build": "vp build",
    "preview": "vp preview",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "hooks:install": "git config core.hooksPath .githooks",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "vp lint",
    "format": "vp fmt",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vp test --run",
    "test:unit-coverage": "vp test --run --coverage",
    "test:e2e": "env -u NO_COLOR playwright test",
    "test:a11y": "env -u NO_COLOR playwright test --config=playwright.a11y.config.ts",
    "release": "semantic-release"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "@nuxt/ui": "^4.6.1",
    "kokoro-js": "^1.2.1",
    "marked": "^18.0.0",
    "phonemizer": "^1.2.1",
    "pinia": "^3.0.4",
    "tailwindcss": "^4.2.2",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@playwright/test": "^1.59.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.6",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.4",
    "@vue/test-utils": "^2.4.6",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "jsdom": "^29.0.2",
    "semantic-release": "^25.0.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.8",
    "vite-plus": "^0.1.18",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  },
  "overrides": {
    "@unhead/vue": "2.1.13",
    "brace-expansion": "2.0.3",
    "defu": "6.1.7",
    "lodash-es": "4.18.1",
    "picomatch": "^4.0.4",
    "unhead": "2.1.13"
  },
  "packageManager": "npm@11.12.1"
}
